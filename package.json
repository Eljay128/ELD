{
  "name": "pourfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Peer-to-peer beverage preference profiles. Local-first, no server, no account.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/relay-test.mjs",
    "check": "node --experimental-strip-types scripts/check-catalog.ts",
    "single": "npm run build && node scripts/build-single-file.mjs",
    "relay": "node relay/server.mjs",
    "test:relay": "npm run build && node scripts/relay-test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
