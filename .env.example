# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000

# Max upload size in megabytes (default 250)
MAX_UPLOAD_MB=250

# Number of frames sampled from the video and sent to the model (default 14, max 24).
# More frames = better gait-cycle coverage, higher token cost.
FRAME_COUNT=14

# Set to "false" to skip the live web-research pass and rely only on the
# built-in knowledge base (faster and cheaper, slightly less current).
WEB_RESEARCH=true
